# ─────────────────────────────────────────────────────────────────────────
# CSE Club Council — environment configuration  (BUILD_PLAN.md §15)
#
# Copy to `.env.local` and fill in. NOTHING here has an insecure fallback in
# code: src/lib/env.ts throws at startup if a required value is missing
# (SECURITY_SPEC §3 — no `|| 'dev-secret'` anywhere).
#
# Generate a 32-byte secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# All crypto secrets below MUST be distinct — reusing one lets a token minted
# for one system be replayed against another (BUILD_PLAN §15).
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://jisahccdnthzgibszwnq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # browser client, RLS-enforced
SUPABASE_SERVICE_ROLE_KEY=                # SERVER ONLY — guarded by import 'server-only'

# ── App / sessions ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # absolute URLs in emails, OG tags, .ics
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                          # >=32 bytes; session signing

# ── Crypto secrets (each a distinct 32-byte random value) ──
CHECKIN_HMAC_SECRET=                       # door-scan QR tokens (§12.5)
ATTENDANCE_HMAC_SECRET=                    # rotating attendance-session codes (§13.8)
CERT_HMAC_SECRET=                          # certificate serials (§12.6)
INVITE_HMAC_SECRET=                        # admin invite tokens
PREFS_HMAC_SECRET=                         # unsubscribe links
CRON_SECRET=                               # cron authorisation (constant-time checked)

# ⚠️ REQUIRED TO LOG IN AT ALL. Encrypts/decrypts the TOTP secrets in
# `admin_totp.secret_encrypted` (src/lib/auth/totp.ts). EVERY admin account on
# this project has TOTP enrolled, so without the RIGHT key — the same one the
# stored secrets were encrypted with — no one can sign in and the panel is
# unreachable. Copy it from the deployed environment; a freshly generated value
# will NOT work against existing accounts.
TOTP_ENC_KEY=

# ── Email ──
# ⚠️ THE TRANSPORT IS CHOSEN BY WHICH CREDENTIALS ARE SET, and GMAIL WINS.
# src/lib/email/transport.ts checks GMAIL_* first and only falls back to Resend.
# Production currently sends over Gmail SMTP: one connection per message, and a
# free app-password account caps near 500 recipients/day. That limit is why bulk
# sends queue instead of going out inline. To send through Resend instead, leave
# the two GMAIL_ values empty.
GMAIL_USER=                                # the Gmail address that sends
GMAIL_APP_PASSWORD=                        # Google app password (shown with spaces; they're stripped)
RESEND_API_KEY=                            # only used when GMAIL_* are unset
EMAIL_FROM="CSE Club Council <council@your-domain.edu>"

# ── Rate limiting (Upstash Redis) — optional locally: in-memory fallback (SPEC §6) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Bot protection (Cloudflare Turnstile) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=            # public site key (must be NEXT_PUBLIC_ for the widget)
TURNSTILE_SECRET_KEY=                      # server-side verification

# ── Monitoring (Sentry) — optional ──
SENTRY_DSN=

# ── Maintenance switch — optional ──
# Break-glass OVERRIDE only. The normal switch is the "Public site" card on the
# /admin dashboard (TH / President / VP), stored in public.site_settings.
# A recognised value here wins over that switch (the card shows "forced");
# unset or unrecognised = the switch decides. /admin/* always stays reachable.
MAINTENANCE_MODE=                          # 1/true/on/yes or 0/false/off/no

# ── Backup + migration scripts only, not the app ──
# scripts/reconcile.mjs and scripts/restore-backup.mjs talk to the Mumbai project
# directly. Same value as SUPABASE_SERVICE_ROLE_KEY unless you are diffing two projects.
MUMBAI_SERVICE_ROLE_KEY=
