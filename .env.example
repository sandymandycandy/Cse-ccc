# ─────────────────────────────────────────────────────────────────────────
# CSE Club Council — environment configuration  (BUILD_PLAN.md §15)
#
# Copy to `.env.local` and fill in. NOTHING here has an insecure fallback in
# code: src/lib/env.ts throws at startup if a required value is missing
# (SECURITY_SPEC §3 — no `|| 'dev-secret'` anywhere).
#
# Generate a 32-byte secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# All crypto secrets below MUST be distinct — reusing one lets a token minted
# for one system be replayed against another (BUILD_PLAN §15).
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://jisahccdnthzgibszwnq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # browser client, RLS-enforced
SUPABASE_SERVICE_ROLE_KEY=                # SERVER ONLY — guarded by import 'server-only'

# ── App / sessions ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # absolute URLs in emails, OG tags, .ics
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                          # >=32 bytes; session signing

# ── Crypto secrets (each a distinct 32-byte random value) ──
CHECKIN_HMAC_SECRET=                       # door-scan QR tokens (§12.5)
ATTENDANCE_HMAC_SECRET=                    # rotating attendance-session codes (§13.8)
CERT_HMAC_SECRET=                          # certificate serials (§12.6)
INVITE_HMAC_SECRET=                        # admin invite tokens
PREFS_HMAC_SECRET=                         # unsubscribe links
CRON_SECRET=                               # cron authorisation (constant-time checked)

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM="CSE Club Council <council@your-domain.edu>"

# ── Rate limiting (Upstash Redis) — optional locally: in-memory fallback (SPEC §6) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Bot protection (Cloudflare Turnstile) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=            # public site key (must be NEXT_PUBLIC_ for the widget)
TURNSTILE_SECRET_KEY=                      # server-side verification

# ── Monitoring (Sentry) — optional ──
SENTRY_DSN=
